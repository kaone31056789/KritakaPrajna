{
  "name": "kritakaprajna",
  "version": "4.0.1",
  "description": "KritakaPrajna — multi-provider AI chat + agent workspace (Soft Machine edition)",
  "author": "Parikshit",
  "private": true,
  "homepage": ".",
  "main": "electron/main.js",
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^11.18.2",
    "katex": "^0.18.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-scripts": "5.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.38",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "to-ico": "^1.1.5",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "start-react": "cross-env BROWSER=none PORT=4123 react-scripts start",
    "start-electron": "wait-on http://localhost:4123 && electron .",
    "start": "concurrently \"npm:start-react\" \"npm:start-electron\"",
    "build": "npm run lint:undef && react-scripts build",
    "dist": "npm run build && electron-builder",
    "test": "react-scripts test",
    "lint:undef": "eslint --no-eslintrc -c .eslintrc.undef.json --ext .js,.jsx src electron",
    "release": "npm run build && electron-builder --publish always",
    "release:dry": "npm run build && electron-builder --publish never"
  },
  "build": {
    "productName": "KritakaPrajna",
    "extends": null,
    "publish": {
      "provider": "github",
      "owner": "kaone31056789",
      "repo": "KritakaPrajna"
    },
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "resources/ollama",
          "to": "ollama",
          "filter": [
            "**/*"
          ]
        }
      ],
      "icon": "assets/logo.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "appx": {
      "applicationId": "KritakaPrajna",
      "backgroundColor": "#1a1a2e",
      "displayName": "KritakaPrajna",
      "identityName": "parikshit3105.KritakaPrajna",
      "publisher": "CN=308CE688-892F-4786-9167-4BA4EB91BA34",
      "publisherDisplayName": "parikshit3105",
      "languages": [
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KritakaPrajna",
      "uninstallDisplayName": "KritakaPrajna",
      "deleteAppDataOnUninstall": true,
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico",
      "installerSidebar": null
    }
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  }
}
